# Optional HTTPS variant of openproject.conf.template.
#
# Not used by default. To enable: place certificate files at
# /opt/openproject/nginx/certs/fullchain.pem and privkey.pem on the server,
# set OPENPROJECT_HTTPS=true (GitHub Variable) and OPENPROJECT_TLS=true in
# .env.prod, then re-run the deploy workflow. deploy.sh selects this template
# instead of openproject.conf.template when OPENPROJECT_TLS=true.
# Do NOT set OPENPROJECT_HTTPS=true unless certs are actually present -
# OpenProject itself will start emitting HSTS headers and secure-only
# cookies, which breaks plain HTTP access.

upstream openproject_web {
	server web:8080;
}

server {
	listen 80;
	server_name ${OPENPROJECT_HOST_NAME};
	return 301 https://$host$request_uri;
}

server {
	listen 443 ssl;
	server_name ${OPENPROJECT_HOST_NAME};

	ssl_certificate     /etc/nginx/certs/fullchain.pem;
	ssl_certificate_key /etc/nginx/certs/privkey.pem;

	client_max_body_size 100m;
	proxy_read_timeout 300s;

	location / {
		proxy_pass http://openproject_web;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto https;
	}
}
