# Example production environment file for OpenProject.
#
# This is a TEMPLATE with placeholders only - it is safe to commit.
# The real file (/opt/openproject/.env.prod on the server) is generated by
# the "Generate Production Environment" step of .github/workflows/deploy.yml
# from GitHub Secrets/Variables and is NEVER committed (see .gitignore).
#
# This single file serves two purposes at once:
#   1. docker compose --env-file .env.prod  -> interpolates ${IMAGE_NAME} etc.
#   2. env_file: .env.prod inside each service -> becomes container env vars.

# --- Compose interpolation (deploy/docker-compose.prod.yml) ---------------
IMAGE_NAME=openproject-custom
IMAGE_TAG=CHANGE_ME_BUILD_TAG
APP_PORT=80
APP_HTTPS_PORT=443
ASSETS_PATH=/var/openproject/assets
DOCKER_NETWORK_NAME=openproject_net

# --- OpenProject / Rails --------------------------------------------------
RAILS_ENV=production

# Generate once with `openssl rand -hex 64`, store as the
# OPENPROJECT_SECRET_KEY_BASE GitHub secret, and never change it - rotating
# it invalidates all sessions and encrypted database content.
SECRET_KEY_BASE=CHANGE_ME_64_BYTE_HEX_SECRET

# Native PostgreSQL on the Ubuntu host, reached via the fixed-subnet Docker
# network's gateway (see deploy/README.md). Password comes from the
# OPENPROJECT_DB_PASSWORD GitHub secret.
DATABASE_URL=postgresql://openproject:CHANGE_ME_DB_PASSWORD@host.docker.internal:5432/openproject

# Used both by nginx (server_name) and by deploy scripts.
OPENPROJECT_HOST_NAME=openproject.example.com
# Actual Rails setting consumed inside the container (double underscore is
# OpenProject's nested-key convention) - keep in sync with the line above.
OPENPROJECT_HOST__NAME=openproject.example.com

# Only set to true once a real TLS-terminating proxy is in front of
# OpenProject (see deploy/nginx/openproject.conf.https.template). Leaving
# this true without TLS will lock you out via secure-only cookies.
OPENPROJECT_HTTPS=false

OPENPROJECT_EDITION=standard
OPENPROJECT_DEFAULT__LANGUAGE=en
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=

# Shared cache across the web + worker containers.
OPENPROJECT_RAILS__CACHE__STORE=memcache
OPENPROJECT_CACHE__MEMCACHE__SERVER=cache:11211

# --- Optional: collaborative editing (hocuspocus) --------------------------
# Leave unset to disable the feature. If enabled, set both to the same
# value used by a hocuspocus deployment you run separately.
# OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__URL=
# OPENPROJECT_COLLABORATIVE__EDITING__HOCUSPOCUS__SECRET=

# --- Optional: outbound email (SMTP) ---------------------------------------
# OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
# OPENPROJECT_SMTP__ADDRESS=smtp.example.net
# OPENPROJECT_SMTP__PORT=587
# OPENPROJECT_SMTP__DOMAIN=openproject.example.com
# OPENPROJECT_SMTP__AUTHENTICATION=plain
# OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true
# OPENPROJECT_SMTP__USER__NAME=CHANGE_ME_SMTP_USERNAME
# OPENPROJECT_SMTP__PASSWORD=CHANGE_ME_SMTP_PASSWORD
